<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- S12 (PRD §13.2): the only two new permissions reminders need. POST_NOTIFICATIONS is
         requested at runtime, only when the user enables the toggle (R-REM-7);
         RECEIVE_BOOT_COMPLETED re-arms alarms after reboot (R-REM-8). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- S15 (D-S15-2): package visibility for install-detected providers. MySword is only
         offered in Settings when detectably installed (spec §4 product rule); API 30+
         requires declaring the package we query. -->
    <queries>
        <package android:name="com.riversoft.android.mysword" />
    </queries>

    <application
        android:name=".DailyReadingsApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyReadingPlanner">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sprint 7 (ESpec §7): Glance widget — today's readings + completion at a glance.
             Periodic system update is the D9 backstop; opportunistic refreshes come from
             MainActivity.onResume and progress mutations. Not exported: only the system
             delivers app-widget broadcasts. -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- S12: alarm target for the daily reminder + the midnight widget refresh
             (D-S12-1/2). Explicit-intent only — never exported. -->
        <receiver
            android:name=".reminders.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- S12: re-arms alarms after reboot (R-REM-8). BOOT_COMPLETED is a protected
             broadcast only the system can send, so non-exported is safe and standard. -->
        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
